{
  "rules": {
    "users": { ".read": "auth != null", "$u": { ".write": "auth != null && auth.uid == $u" } },
    "names": { ".read": "auth != null", "$n": { ".write": "auth != null && !data.exists()" } },
    "inbox": {
      "$u": {
        ".read": "auth != null && auth.uid == $u",
        "$m": { ".write": "auth != null && (!data.exists() || auth.uid == $u)" }
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$r": {
        ".write": "auth != null && (!data.exists() || data.child('owner').val() == auth.uid)",
        "members": {
          "$m": { ".write": "auth != null && (auth.uid == $m || root.child('rooms').child($r).child('members').child(auth.uid).exists())" }
        }
      }
    }
  }
}
