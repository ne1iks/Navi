rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isFriend() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'you@gmail.com', 'friend1@gmail.com', 'friend2@gmail.com'
        ];
    }
    function isMember(c) {
      return request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.members;
    }
    match /users/{uid} {
      allow read: if isFriend();
      allow write: if isFriend() && request.auth.uid == uid;
    }
    match /chats/{c} {
      allow read: if isFriend() && request.auth.uid in resource.data.members;
      allow create: if isFriend() && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 20;
      allow update: if isFriend() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText','updatedAt']);
      match /messages/{m} {
        allow read: if isFriend() && isMember(c);
        allow create: if isFriend() && isMember(c) && request.resource.data.uid == request.auth.uid
          && (!('text' in request.resource.data) || request.resource.data.text.size() <= 1000);
        allow update: if isFriend() && isMember(c)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions','readBy']);
        allow delete: if isFriend() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
